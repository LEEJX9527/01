{
  "name": "calorie-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && tsc -p companion && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts companion/*.test.ts",
    "companion": "node --experimental-strip-types --no-warnings companion/cli.ts",
    "build:web": "vue-tsc --noEmit && vite build",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "idb": "8.0.3",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vue-tsc": "3.3.11"
  }
}
